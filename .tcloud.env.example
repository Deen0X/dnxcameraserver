# TCloud · Telegram como endpoint de subidas (NO versionar este fichero)
#
# Copia este fichero a `.tcloud.env` y rellena los valores.
# `.tcloud.env` está en .gitignore: el token no debe acabar en un commit.

# URL del servicio (por defecto, el de tu máquina)
TCLOUD_URL=http://127.0.0.1:8931

# Token de API (pídelo al proyecto del servicio)
TCLOUD_KEY=

# Canal destino de los artefactos
TCLOUD_CHAT=

# Topic del canal (0 = General)
TCLOUD_TOPIC=2

# Nombre del proyecto que aparece en el caption
TCLOUD_PROJECT=
